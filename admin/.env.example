# Browser values (public; select the SAME Supabase project as the server)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-project-public-key
# VITE_PLATFORM_API_BASE is optional; leave unset for same-origin /api/platform/*.

# Server-only values for the platform functions (never prefix secrets with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
PLATFORM_ADMIN_EMAILS=your-explicit-admin-allowlist
# Configure these with the matching environment's price identifiers for plan labels.
VITE_STRIPE_PRICE_STARTER=your-starter-price-id
VITE_STRIPE_PRICE_GROWTH=your-growth-price-id
VITE_STRIPE_PRICE_PRO=your-pro-price-id
VITE_STRIPE_PRICE_FOUNDER=your-founder-price-id
# Set the Founder Price ID for this SAME environment on the standalone Admin server
# so checkout history can distinguish Founder from recurring attempts.

# Local Vite dev proxy only: set explicitly to a verified Sandbox API URL.
# ADMIN_API_PROXY_TARGET=your-explicit-local-api-target
