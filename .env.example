# Supabase Configuration (Required for Multi-tenant Features)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase (for API endpoints)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Legacy fallback environment variables
# (These are overridden by user-specific credentials from database)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
