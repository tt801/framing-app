# Supabase Configuration (Required for Multi-tenant Features)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase (for API endpoints)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public app URL used for Stripe return/cancel links
# Set to your production domain in Vercel, e.g. https://framersapp.com
APP_BASE_URL=http://localhost:5173

# Cron auth secret (required if scheduled-check endpoint is enabled in vercel.json)
CRON_SECRET=

# Integration credentials are per-user and stored in Supabase via API Settings:
# - twilio_account_sid
# - twilio_auth_token
# - twilio_whatsapp_number
# - microsoft_client_id
# - microsoft_client_secret
# - microsoft_tenant_id
# - outlook_from_email
# - mailchimp_api_key
# - mailchimp_server
